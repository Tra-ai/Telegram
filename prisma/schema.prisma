generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}
enum ChatType {
  PRIVATE
  GROUP
}
enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  // Bumped on password change / "log out everywhere" → invalidates all older JWTs
  tokenVersion Int      @default(0)
  bio          String   @default("")
  avatarUrl    String?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  // Doubles as presence: online = lastSeen within the last 40s
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  memberships Member[]
  messages    Message[]
  blocking    Block[]   @relation("Blocker")
  blockedBy   Block[]   @relation("Blocked")
  // Bots: a bot is a normal User row (username ends with "bot") + a Bot row. These two are relation-only (no new User columns).
  botProfile  Bot?      @relation("BotUser")
  ownedBots   Bot[]     @relation("BotOwner")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Chat {
  id         String   @id @default(cuid())
  type       ChatType
  title      String?
  avatarUrl  String?
  ownerId    String?
  // PRIVATE: "idA:idB" (sorted). idA:idA = Saved Messages
  privateKey String?  @unique
  createdAt  DateTime @default(now())

  members  Member[]
  messages Message[]
}

model Member {
  id         String    @id @default(cuid())
  chatId     String
  userId     String
  isAdmin    Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now())
  typingAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  senderId  String
  type      MessageType @default(TEXT)
  text      String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  duration  Int?
  replyToId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  chat    Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("Replies")

  @@index([chatId, createdAt])
  @@index([chatId, updatedAt])
  @@index([senderId])
}

// ---- Bots ----
model Bot {
  id          String   @id @default(cuid())
  userId      String   @unique
  ownerId     String
  // sha256 of the secret half of the token. The token itself is shown once and never stored.
  tokenHash   String   @unique
  description String   @default("")
  commands    Json?
  createdAt   DateTime @default(now())

  user    User        @relation("BotUser", fields: [userId], references: [id], onDelete: Cascade)
  owner   User        @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  updates BotUpdate[]

  @@index([ownerId])
}

// Queue of new messages for a bot (Telegram-style getUpdates). update_id = id.
model BotUpdate {
  id        Int      @id @default(autoincrement())
  botId     String
  messageId String
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, id])
}
