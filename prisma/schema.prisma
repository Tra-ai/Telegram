generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}
enum ChatType {
  PRIVATE
  GROUP
}
enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // E.164 (+855...). Set only for accounts created/verified through SMS login. Never sent to other users.
  phone        String?  @unique
  displayName  String
  passwordHash String
  // Bumped on password change / "log out everywhere" → invalidates all older JWTs
  tokenVersion Int      @default(0)
  bio          String   @default("")
  avatarUrl    String?
  // Backbook (social) profile extras
  cover        String?
  gender       String   @default("male")
  details      Json?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  // Doubles as presence: online = lastSeen within the last 40s
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  memberships Member[]
  messages    Message[]
  blocking    Block[]   @relation("Blocker")
  blockedBy   Block[]   @relation("Blocked")
  // Bots: a bot is a normal User row (username ends with "bot") + a Bot row. These two are relation-only (no new User columns).
  botProfile  Bot?      @relation("BotUser")
  ownedBots   Bot[]     @relation("BotOwner")
  passkeys    AdminPasskey[]
  posts       Post[]
  bbPosts     BbPost[]
  bbReacts    BbReact[]
  bbComments  BbComment[]
  bbNotifs    BbNotification[] @relation("NotifTo")
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  text      String   @default("")
  imageUrl  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Chat {
  id         String   @id @default(cuid())
  type       ChatType
  title      String?
  avatarUrl  String?
  ownerId    String?
  // PRIVATE: "idA:idB" (sorted). idA:idA = Saved Messages
  privateKey String?  @unique
  // Backbook chat theme (1-based index)
  theme      Int      @default(1)
  createdAt  DateTime @default(now())

  members  Member[]
  messages Message[]
}

model Member {
  id         String    @id @default(cuid())
  chatId     String
  userId     String
  isAdmin    Boolean   @default(false)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now())
  typingAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  senderId  String
  type      MessageType @default(TEXT)
  text      String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  duration  Int?
  replyToId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  chat    Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("Replies")

  @@index([chatId, createdAt])
  @@index([chatId, updatedAt])
  @@index([senderId])
}

// ---- Bots ----
model Bot {
  id          String   @id @default(cuid())
  userId      String   @unique
  ownerId     String
  // sha256 of the secret half of the token. The token itself is shown once and never stored.
  tokenHash   String   @unique
  description String   @default("")
  commands    Json?
  createdAt   DateTime @default(now())

  user    User        @relation("BotUser", fields: [userId], references: [id], onDelete: Cascade)
  owner   User        @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  updates BotUpdate[]

  @@index([ownerId])
}

// Queue of new messages for a bot (Telegram-style getUpdates). update_id = id.
model BotUpdate {
  id        Int      @id @default(autoincrement())
  botId     String
  messageId String
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, id])
}

// Face / fingerprint / screen-lock (WebAuthn) credentials that unlock the admin dashboard
model AdminPasskey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  name         String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ---------------- Backbook (Facebook-style social app) ----------------
model BbPost {
  id         String   @id @default(cuid())
  userId     String
  type       String   @default("normal") // normal | background | image | profilePhoto | cover | share
  text       String   @default("")
  background Int?
  images     String[]
  sharedId   String?
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shared   BbPost?     @relation("Shares", fields: [sharedId], references: [id], onDelete: SetNull)
  shares   BbPost[]    @relation("Shares")
  reacts   BbReact[]
  comments BbComment[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model BbReact {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  post BbPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model BbComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  text      String   @default("")
  photo     String?
  likes     String[] // user ids
  createdAt DateTime @default(now())

  post    BbPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  BbComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BbComment[] @relation("Replies")

  @@index([postId, createdAt])
  @@index([parentId])
}

// Friend request / friendship. PENDING = request, ACCEPTED = friends.
model BbFriend {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId])
  @@index([recipientId])
}

model BbFollow {
  followerId  String
  followingId String

  @@id([followerId, followingId])
}

model BbNotification {
  id        String   @id @default(cuid())
  userId    String
  senderId  String?
  type      String
  content   String
  click     String   @default("/")
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("NotifTo", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BbSearch {
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  @@id([userId, targetId])
}
