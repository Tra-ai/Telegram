# Neon: Connection string ជា "Pooled" (មាន -pooler ក្នុង host)
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon: Connection string ជា "Direct" (គ្មាន -pooler) — ប្រើសម្រាប់ prisma db push
DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="long-random-string-at-least-32-chars"
# Vercel → Storage → Blob → បង្កើត store ហើយ token នឹងចូលអូតូ
BLOB_READ_WRITE_TOKEN=""
CLIENT_ORIGIN="https://your-frontend.vercel.app"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
